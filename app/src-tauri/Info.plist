<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the bundle's Info.plist by the Tauri bundler. macOS shows the first text the
     first time Tokidoki asks for the microphone (push-to-talk), and the second the first time
     its browser opens a page on the local network. The browser may load plain http pages (a
     site on a home network often has no https); the app's own requests stay https only. -->
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Tokidoki listens only while you hold a conversation by voice, and turns what you say into text on this Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Tokidoki's browser opens sites on your own network when you send it to one, such as a page on a home server.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
